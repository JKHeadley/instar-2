{
  "name": "@instar/constitutional-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:all": "npm run typecheck && npm run build && vitest run --reporter=default --reporter=json --outputFile=.test-results.json && npm run lint && node scripts/check-contract-map.mjs",
    "lint": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  }
}
