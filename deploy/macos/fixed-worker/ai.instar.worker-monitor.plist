<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fixed M4-L monitor system job (M4). Installed root:wheel 0644 at
  /Library/LaunchDaemons/ai.instar.worker-monitor.plist by the operator's
  administrative path only. The installer materializes the single token
  @RELEASE_DIR@ (/Library/Instar2/m4-launch/releases/<release-digest>); there is
  no `current` symlink. Only the supervisor service is restarted, and only after
  an unsuccessful exit: its own restart breaker exits successfully (0) after five
  consecutive unstable starts, so launchd stops restarting it and the failure
  settles (Rules 55/61). No worker is ever restarted, and no global resource keys
  are set (they are host-wide).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.instar.worker-monitor</string>
  <key>UserName</key>
  <string>root</string>
  <key>GroupName</key>
  <string>wheel</string>
  <key>Program</key>
  <string>@RELEASE_DIR@/bin/instar-worker-enforcer</string>
  <key>ProgramArguments</key>
  <array>
    <string>@RELEASE_DIR@/bin/instar-worker-enforcer</string>
    <string>supervise</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/private/var/db/instar2-worker</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardInPath</key>
  <string>/dev/null</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
